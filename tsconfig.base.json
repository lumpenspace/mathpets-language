{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@pets/engine": ["packages/engine/src/index.ts"],
      "@pets/model-api": ["packages/model-api/src/index.ts"],
      "@pets/language": ["packages/language/src/index.ts"]
    }
  }
}
