{
  "name": "mathpets-language",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run generate:parser && npm run build:extension",
    "build:extension": "esbuild packages/ide/src/compiler-entry.ts --bundle --platform=node --format=cjs --outfile=packages/ide/dist/compiler.cjs",
    "generate:parser": "lezer-generator packages/language/src/pets.grammar -o packages/language/src/generated/parser.ts --typeScript",
    "package:extension": "npm run build && cd packages/ide && vsce package --no-dependencies",
    "test": "npm run build && node scripts/test-compiler.mjs && node scripts/test-extension.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@lezer/generator": "^1.8.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/node": "^24.0.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
